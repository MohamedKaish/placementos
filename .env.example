# PlacementOS - Environment Configuration
# Copy this file to .env.local and configure your credentials.
# DO NOT COMMIT .env.local TO GIT.

# ==========================================
# Google Gemini GenAI API (Strictly Server-Side)
# ==========================================
# Used for language understanding (resume extraction, JD parsing, rubric suggestions)
# Never prefix with NEXT_PUBLIC_ to prevent client-side leakage.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# Firebase Configuration (Client & Server)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=placementos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=placementos-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=placementos-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
